# =============================================================================
# Root Gitignore for IP Address Management System
# =============================================================================

# Environment files
.env
.env.local
.env.*.local

# Docker volumes and data
docker/data/
*.volume

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temp files
*.tmp
*.temp
.cache/

# Node modules (at root level if any)
node_modules/

# Vendor directories (at root level if any)
vendor/

# Build artifacts
dist/
build/

docs/*